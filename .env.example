# Grok API key from https://console.x.ai
XAI_API_KEY=

# Optional — defaults to grok-4-1-fast-reasoning
# XAI_MODEL=grok-4.6

# Optional — overrides per-step reasoning effort (none | low | medium | high).
# Defaults: low for limitations, chart, and revisions; medium for the evaluation.
# XAI_REASONING_EFFORT=low
